# BitBrowser 本地 API
BITBROWSER_API=http://127.0.0.1:54345
BITBROWSER_PROFILE_ID=你的浏览器窗口ID

# OpenAI 兼容接口（DeepSeek 2026-08 文档: https://api-docs.deepseek.com/）
# 推荐模型: deepseek-v4-flash（快/省）或 deepseek-v4-pro
# 文案只根据商品名生成话题和标签，不传视频
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# 可选代理（大陆网络）——也可在软件「设置」页只填端口，如 7890
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
